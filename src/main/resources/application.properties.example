server.port=8082
spring.application.name=logistics-company

# Admin user seeded on first startup
admin.seed.username=admin
admin.seed.password=admin
admin.seed.email=admin@localhost

# MySQL — create the database first, then fill in your credentials
spring.datasource.url=jdbc:mysql://localhost/logistics-company?createDatabaseIfNotExist=true&useSSL=false
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JWT — replace with a strong random string (min 32 characters)
jwt.secret=replace-with-your-own-secret-key-min-32-chars
jwt.expiration=86400000

spring.jpa.hibernate.ddl-auto=update
